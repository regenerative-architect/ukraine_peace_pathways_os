{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://planetaryrestorationarchive.com/schemas/evidence.schema.json",
  "title": "evidence",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": [
      "id",
      "name",
      "date",
      "class",
      "claim",
      "url",
      "implication"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*$"
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "date": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "class": {
        "type": "string",
        "minLength": 1
      },
      "claim": {
        "type": "string",
        "minLength": 1
      },
      "url": {
        "type": "string",
        "pattern": "^https?://"
      },
      "implication": {
        "type": "string",
        "minLength": 1
      }
    },
    "additionalProperties": true
  }
}
