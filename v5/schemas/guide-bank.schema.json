{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://planetaryrestorationarchive.com/schemas/guide-bank.schema.json",
  "title": "guide-bank",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": [
      "id",
      "entityId",
      "solutionId",
      "classification",
      "reviewStatus",
      "decisionOwner",
      "constraint",
      "proposedFirstAction",
      "legalGate",
      "verification",
      "failure",
      "requiredEvidence",
      "fallback"
    ],
    "properties": {
      "id": {
        "type": "string",
        "minLength": 3
      },
      "entityId": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*$"
      },
      "solutionId": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*$"
      },
      "classification": {
        "type": "string",
        "minLength": 1
      },
      "reviewStatus": {
        "type": "string",
        "minLength": 1
      },
      "decisionOwner": {
        "type": "string",
        "minLength": 1
      },
      "constraint": {
        "type": "string",
        "minLength": 1
      },
      "proposedFirstAction": {
        "type": "string",
        "minLength": 1
      },
      "legalGate": {
        "type": "string",
        "minLength": 1
      },
      "verification": {
        "type": "string",
        "minLength": 1
      },
      "failure": {
        "type": "string",
        "minLength": 1
      },
      "fallback": {
        "type": "string",
        "minLength": 1
      },
      "requiredEvidence": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "additionalProperties": true
  }
}
