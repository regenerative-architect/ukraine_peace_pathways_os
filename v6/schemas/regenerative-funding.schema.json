{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "asOf",
    "classification",
    "responsibilityStatement",
    "rules",
    "modes",
    "funderKinds",
    "alternatives",
    "sourceIds"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^4\\.1\\.0$"
    },
    "asOf": {
      "type": "string",
      "format": "date"
    },
    "classification": {
      "type": "string",
      "minLength": 8
    },
    "responsibilityStatement": {
      "type": "string",
      "minLength": 8
    },
    "rules": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "string",
        "minLength": 8
      }
    },
    "sourceIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "modes": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "description"
        ],
        "properties": {
          "id": {
            "enum": [
              "parallel-now",
              "reciprocal-conditional",
              "post-agreement"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 8
          },
          "description": {
            "type": "string",
            "minLength": 8
          }
        }
      }
    },
    "funderKinds": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "constraint"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 8
          },
          "constraint": {
            "type": "string",
            "minLength": 8
          }
        }
      }
    },
    "alternatives": {
      "type": "array",
      "minItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "stakeholderKinds",
          "cooperationMode",
          "fundingClass",
          "mechanism",
          "proposedFunding",
          "steps",
          "legalGate",
          "metrics",
          "stopCondition",
          "sourceIds",
          "classification"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 8
          },
          "stakeholderKinds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 3
            }
          },
          "cooperationMode": {
            "enum": [
              "parallel-now",
              "reciprocal-conditional",
              "post-agreement"
            ]
          },
          "fundingClass": {
            "enum": [
              "authorized-existing",
              "voluntary-proposed",
              "subject-to-legal-resolution"
            ]
          },
          "mechanism": {
            "type": "string",
            "minLength": 8
          },
          "proposedFunding": {
            "type": "string",
            "minLength": 8
          },
          "steps": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "string",
              "minLength": 8
            }
          },
          "legalGate": {
            "type": "string",
            "minLength": 8
          },
          "metrics": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "string",
              "minLength": 8
            }
          },
          "stopCondition": {
            "type": "string",
            "minLength": 8
          },
          "sourceIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 3
            }
          },
          "classification": {
            "type": "string",
            "pattern": "^UNVERIFIED"
          }
        }
      }
    }
  }
}
